{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "123-auto-cash",
    "main": "server/worker.mjs",
    "compatibility_date": "2026-03-18",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/admin", "/admin/*"]
    },
    "d1_databases": [{
        "binding": "DB",
        "database_name": "autocash-production",
        "database_id": "43269c2f-3fd5-44e4-bc58-9a4515073b03",
        "migrations_dir": "migrations"
    }]
}
